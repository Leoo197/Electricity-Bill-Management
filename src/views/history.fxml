<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.HistoryController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color:#111827;">

    <padding>
        <Insets top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

    <Label text="Bill History"
           style="-fx-font-size:26;
                  -fx-font-weight:bold;
                  -fx-text-fill:white;"/>

    <TextArea fx:id="historyArea"
              prefWidth="700"
              prefHeight="500"
              editable="false"/>

</VBox>