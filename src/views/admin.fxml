<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color:#0f172a;">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="Admin Dashboard"
           style="-fx-font-size:28;
                  -fx-text-fill:white;
                  -fx-font-weight:bold;"/>

    <TextField fx:id="billPerUnitField"
               promptText="Enter Bill Per Unit"
               prefWidth="300"/>

    <TextField fx:id="domesticField"
               promptText="Enter Domestic Tariff"
               prefWidth="300"/>

    <TextField fx:id="commercialField"
               promptText="Enter Commercial Tariff"
               prefWidth="300"/>

    <TextField fx:id="agriculturalField"
               promptText="Enter Agricultural Tariff"
               prefWidth="300"/>

    <TextField fx:id="taxField"
               promptText="Enter Tax Percentage"
               prefWidth="300"/>

    <Button text="Save Changes"
            onAction="#saveTariff"
            prefWidth="250"
            style="-fx-background-color:#2563eb;
                   -fx-text-fill:white;
                   -fx-font-size:16;
                   -fx-font-weight:bold;"/>

    <Button text="View Consumers"
            onAction="#viewConsumers"
            prefWidth="250"/>

    <Button text="View Bills"
            onAction="#viewBills"
            prefWidth="250"/>

    <Button text="Logout"
            onAction="#logout"
            prefWidth="250"/>

</VBox>
