<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ConsumerController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color:#111827;">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="Consumer Dashboard"
           style="-fx-font-size:28;
                  -fx-font-weight:bold;
                  -fx-text-fill:white;"/>
    <Label fx:id="consumerIdLabel"
           style="-fx-font-size:18;
              -fx-text-fill:#d1d5db;"/>

    <Button text="Generate Bill"
            onAction="#openGenerateBill"
            prefWidth="250"
            style="-fx-background-color:#2563eb;
                   -fx-text-fill:white;
                   -fx-font-size:16;
                   -fx-font-weight:bold;"/>

    <Button text="History"
            onAction="#loadBills"
            prefWidth="250"
            style="-fx-background-color:#10b981;
                   -fx-text-fill:white;
                   -fx-font-size:16;
                   -fx-font-weight:bold;"/>

    <Button text="Logout"
            onAction="#logout"
            prefWidth="250"
            style="-fx-background-color:#ef4444;
                   -fx-text-fill:white;
                   -fx-font-size:16;
                   -fx-font-weight:bold;"/>

</VBox>